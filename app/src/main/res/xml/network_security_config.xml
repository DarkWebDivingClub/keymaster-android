<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (ws://) for local development/testing relays -->
    <!-- Allow cleartext (ws://) for all connections.
         Avatar relays on private networks use ws:// not wss://. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
